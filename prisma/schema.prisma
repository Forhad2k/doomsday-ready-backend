
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Movie {
  id          String   @id @default(uuid())
  title       String   @unique
  releaseYear Int
  runtime     Int
  watched     Boolean  @default(false)

  prerequisites MovieDependency[] @relation("Movie")
  dependents    MovieDependency[] @relation("Prerequisite")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MovieDependency {
  movieId        String
  prerequisiteId String

  movie Movie @relation(
    "Movie",
    fields: [movieId],
    references: [id],
    onDelete: Cascade
  )

  prerequisite Movie @relation(
    "Prerequisite",
    fields: [prerequisiteId],
    references: [id],
    onDelete: Cascade
  )

  @@id([movieId, prerequisiteId])
  @@index([prerequisiteId])
}

model Cinema {
  id          String   @id @default(uuid())
  name        String   @unique
  bundleSizes Int[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
